<!DOCTYPE html>
<html lang="ko" xmlns:th="http://www.thymeleaf.org">
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<h2>도서 대여 정보</h2>
	<ul>
		<li th:each="name :${bookName}">
			<p>도서명: <span th:text="${bookName}"></span></p>
			<p>저자: <span th:text="${author}"></span></p>
			<p>ISBN: <span th:text="${ISBN}"></span></p>
			<p>대여자: <span th:text="${renterName}"></span></p>
		</li>
	</ul>
	
	<a href="/book/rental">뒤로가기</a>
</body>
</html>