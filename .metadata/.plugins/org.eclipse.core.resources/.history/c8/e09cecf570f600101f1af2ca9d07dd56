package com.green;

import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;

@Controller
public class MemberController {

    private final SamplePjt02Application samplePjt02Application;

    MemberController(SamplePjt02Application samplePjt02Application) {
        this.samplePjt02Application = samplePjt02Application;
    }
	
	// 아래 작성한 메서드는 핸들러 메서드임
	// 회원가입 양식
	@GetMapping("/member/signup") // http://localhost8090/member/signup 의 경로를 매핑(=연결)
	public String signUpForm() {
		System.out.println("signUpForm()"); // log 역할(에러가 있는지 확인)
		return "signUpForm"; // 응답에 사용하는 html 파일 이름 반환
	}
	
	@PostMapping("/member/signin")
	public String signInForm() {
		System.out.println("signInForm");
		return "signinform";
	}
}

